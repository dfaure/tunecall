import { Button, LineEdit, ListView, TabWidget } from "std-widgets.slint";

struct SongResult {
    title: string,
    subtitle: string, // book title · page
}

struct BookEntry {
    name: string, // book stem (no extension)
    title: string, // human-readable title (empty if the index has none)
    installed: bool, // PDF present (searchable now) vs index-only
}

struct SetlistEntry {
    name: string,
    song-count: int,
}

struct SetlistSongEntry {
    title: string,
    subtitle: string, // book title · page (the stem if no friendly title)
    available: bool, // matching PDF installed (else greyed, opens to a render error)
}

// Hairline dividers. HSeparator is a horizontal line (full width, 1px tall) for
// separating stacked rows; VSeparator is a vertical line (1px wide, full height)
// for separating side-by-side columns. Each leaves the other dimension to fill,
// so don't swap them — a fixed size on the wrong axis breaks the parent layout.
component HSeparator inherits Rectangle {
    height: 1px;
    background: #0000001a;
}

component VSeparator inherits Rectangle {
    width: 1px;
    background: #0000001a;
}

// One row of a ListView: a hover highlight, the row content (laid out
// horizontally via @children), and a hairline bottom separator. Used by every
// list so rows read as discrete units instead of floating text.
component ListRow inherits Rectangle {
    height: content.preferred-height;
    background: hover.has-hover ? #00000008 : transparent;

    hover := TouchArea { }
    content := HorizontalLayout {
        padding: 8px;
        spacing: 6px;
        @children
    }
    HSeparator {
        y: parent.height - self.height;
        width: 100%;
    }
}

component ResultRow {
    in property <SongResult> data;
    callback clicked <=> touchArea.clicked;

    Rectangle {
        background: touchArea.has-hover ? #00000010 : transparent;
        touchArea := TouchArea {
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                Text {
                    text: data.title;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: data.subtitle;
                    color: gray;
                    font-size: 16px;
                    // Elide instead of demanding full width (a long book title
                    // must not push trailing buttons off-screen).
                    overflow: elide;
                }
            }
        }
        HSeparator {
            y: parent.height - self.height;
            width: 100%;
        }
    }
}

export component AppWindow inherits Window {
    title: "TuneCall";
    default-font-size: 20px;
    // No fixed preferred-width/height: on Android they made the window size to
    // the layout instead of filling the screen (search field hidden until a
    // resize/maximize forced a relayout). See slint-ui/slint#11170, #5391.

    // --- top-level tabs ---
    // 0 = Search, 1 = Setlists, 2 = Books. Rust sets it at startup (Books when
    // nothing is installed yet, to guide first-time setup; Search otherwise).
    in-out property <int> active-tab;

    // --- search ---
    in property <[SongResult]> results;
    in property <string> status;
    callback search(string);
    callback open-result(int); // index into `results`
    callback reload();

    // --- books list (setup-time: which PDFs are indexed/supported) ---
    in property <[BookEntry]> book-list;

    // --- setlists ---
    in property <[SetlistEntry]> setlists;
    in property <int> editing-index: -1; // -1 = list view, >=0 = editing that setlist
    in property <string> editing-name; // name of the setlist being edited
    in property <[SetlistSongEntry]> editing-songs;
    in property <[SongResult]> add-results; // search hits while adding songs
    callback create-setlist(string);
    callback rename-setlist(int/* index */, string/* new name */);
    callback delete-setlist(int);
    callback edit-setlist(int); // enter the editor
    callback close-setlist-editor();
    callback play-setlist(int); // open the setlist in the viewer
    callback setlist-add-search(string);
    callback setlist-add-song(int); // index into `add-results`
    callback preview-song(int); // preview `add-results[i]` in the viewer before adding
    callback setlist-remove-song(int); // index into `editing-songs`
    callback setlist-move-up(int);
    callback setlist-move-down(int);

    // --- viewer ---
    in property <bool> viewer-visible: false;
    in property <string> viewer-title;
    in property <image> page-image;
    in property <int> page-number;
    in property <int> page-count;
    in property <int> result-index; // 0-based position of the open song in the nav list
    in property <int> result-count; // total number of songs being navigated
    in property <string> viewer-error;
    callback prev-page(); // within the open PDF
    callback next-page();
    callback prev-result(); // across the nav list (search results or a setlist)
    callback next-result();
    callback close-viewer();

    // On Android the search field keeps focus while the viewer covers it, so its
    // text caret/selection handles bleed through over the PDF. Drop focus while
    // the viewer is up and restore it (only on the Search tab) when we return.
    changed viewer-visible => {
        if (root.viewer-visible) {
            searchLineEdit.clear-focus();
        } else if (root.active-tab == 0) {
            searchLineEdit.focus();
        }
    }

    TabWidget {
        width: 100%;
        height: 100%;
        current-index <=> root.active-tab;

        Tab {
            title: "Search";

            VerticalLayout {
                padding: 8px;
                spacing: 8px;

                searchLineEdit := LineEdit {
                    placeholder-text: @tr("Search songs");
                    font-size: 28px;
                    edited(text) => { root.search(text); }
                }

                Text {
                    text: root.status;
                    color: gray;
                    wrap: word-wrap;
                }

                resultsList := ListView {
                    vertical-stretch: 1;
                    mouse-drag-pan-enabled: true;
                    horizontal-scrollbar-policy: always-off;
                    for result[idx] in root.results : ResultRow {
                        data: result;
                        width: resultsList.viewport-width;
                        clicked => { root.open-result(idx); }
                    }
                }
            }
        }

        Tab {
            title: "Setlists";

            Rectangle {
                // List view: every setlist, with create / play / edit / delete.
                if root.editing-index < 0 : VerticalLayout {
                    padding: 8px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        newName := LineEdit {
                            placeholder-text: "New setlist name";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Create";
                            enabled: newName.text != "";
                            clicked => {
                                root.create-setlist(newName.text);
                                newName.text = "";
                            }
                        }
                    }

                    setlistsList := ListView {
                        vertical-stretch: 1;
                        mouse-drag-pan-enabled: true;
                        horizontal-scrollbar-policy: always-off;
                        for s[idx] in root.setlists : ListRow {
                            width: setlistsList.viewport-width;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: s.name;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "\{s.song-count} song(s)";
                                    color: gray;
                                    font-size: 16px;
                                }
                            }
                            Button {
                                text: "Play";
                                enabled: s.song-count > 0;
                                clicked => { root.play-setlist(idx); }
                            }
                            Button {
                                text: "Edit";
                                clicked => { root.edit-setlist(idx); }
                            }
                            Button {
                                text: "Delete";
                                clicked => { root.delete-setlist(idx); }
                            }
                        }
                    }
                }

                // Editor view: rename/close on top, then two columns — the
                // setlist (reorder/remove) on the left, a live song search with
                // preview/add on the right (Mobile Sheets style).
                if root.editing-index >= 0 : VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;
                        editName := LineEdit {
                            text: root.editing-name;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Rename";
                            enabled: editName.text != "";
                            clicked => { root.rename-setlist(root.editing-index, editName.text); }
                        }
                        Button {
                            text: "Close";
                            clicked => { root.close-setlist-editor(); }
                        }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 12px;

                        // Left column: the setlist itself.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            Text {
                                text: "In this setlist";
                                font-weight: 700;
                            }
                            songsList := ListView {
                                vertical-stretch: 1;
                                mouse-drag-pan-enabled: true;
                                horizontal-scrollbar-policy: always-off;
                                for song[i] in root.editing-songs : ListRow {
                                    width: songsList.viewport-width;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text {
                                            text: "\{i + 1}. \{song.title}";
                                            font-weight: 700;
                                            color: song.available ? black : gray;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: song.available ? song.subtitle : "\{song.subtitle} — PDF missing";
                                            color: song.available ? gray : #b00020;
                                            font-size: 14px;
                                            overflow: elide;
                                        }
                                    }
                                    // Reorder/remove grouped tightly so they read
                                    // as one control cluster for this row.
                                    HorizontalLayout {
                                        spacing: 2px;
                                        Button {
                                            text: "▲";
                                            width: 44px;
                                            enabled: i > 0;
                                            clicked => { root.setlist-move-up(i); }
                                        }
                                        Button {
                                            text: "▼";
                                            width: 44px;
                                            enabled: i < root.editing-songs.length - 1;
                                            clicked => { root.setlist-move-down(i); }
                                        }
                                        Button {
                                            text: "✕";
                                            width: 44px;
                                            clicked => { root.setlist-remove-song(i); }
                                        }
                                    }
                                }
                            }
                        }

                        VSeparator { }

                        // Right column: live search to add songs. The field is
                        // always visible (no toggle); Preview opens the song in
                        // the viewer so the user isn't choosing blind.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            addSearch := LineEdit {
                                placeholder-text: @tr("Search songs to add");
                                edited(text) => { root.setlist-add-search(text); }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                addList := ListView {
                                    mouse-drag-pan-enabled: true;
                                    horizontal-scrollbar-policy: always-off;
                                    for r[ri] in root.add-results : ListRow {
                                        width: addList.viewport-width;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: r.title;
                                                font-weight: 700;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: r.subtitle;
                                                color: gray;
                                                font-size: 16px;
                                                overflow: elide;
                                            }
                                        }
                                        Button {
                                            text: "Preview";
                                            clicked => { root.preview-song(ri); }
                                        }
                                        Button {
                                            text: "Add";
                                            clicked => { root.setlist-add-song(ri); }
                                        }
                                    }
                                }
                                // Guidance while no search has been run yet.
                                if root.add-results.length == 0 : Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "Type above to find songs to add.";
                                    color: gray;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        Tab {
            title: "Books";

            // Setup-time: every indexed book, marking whether its PDF is
            // installed. PDFs are not bundled (copyright), so this tells the user
            // which PDFs they can install to enable a book.
            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Supported books";
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Reload";
                        clicked => { root.reload(); }
                    }
                }

                Text {
                    text: "Reload fetches the latest indexes. Install the matching PDF to enable a book; PDFs are not bundled.";
                    color: gray;
                    font-size: 16px;
                    wrap: word-wrap;
                }

                Text {
                    text: root.status;
                    color: gray;
                    font-size: 16px;
                    wrap: word-wrap;
                }

                booksList := ListView {
                    vertical-stretch: 1;
                    mouse-drag-pan-enabled: true;
                    horizontal-scrollbar-policy: always-off;
                    for book in root.book-list : ListRow {
                        width: booksList.viewport-width;
                        // Title (from the index) on top, file stem underneath in
                        // gray. When the index carries no title, the stem is the
                        // only name we have, so it stands in as the main line.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: book.title != "" ? book.title : book.name;
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                            if book.title != "" : Text {
                                text: book.name;
                                color: gray;
                                font-size: 16px;
                                wrap: word-wrap;
                            }
                        }
                        Text {
                            text: book.installed ? "installed" : "PDF missing";
                            color: book.installed ? #2e7d32 : gray;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Viewer overlay (covers the whole window, tab bar included, when a song is
    // open). A later sibling than the TabWidget, so it draws on top.
    if root.viewer-visible : Rectangle {
        width: root.width;
        height: root.height;
        background: white;

        VerticalLayout {
            padding: 8px;
            spacing: 6px;

            // Top bar navigates the nav list (the search hits for a song, or the
            // songs of a setlist), so you can step through without going back.
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "‹ Prev";
                    enabled: root.result-index > 0;
                    clicked => { root.prev-result(); }
                }
                Text {
                    text: "\{root.result-index + 1} / \{root.result-count}";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Next ›";
                    enabled: root.result-index < root.result-count - 1;
                    clicked => { root.next-result(); }
                }
                Button {
                    text: "Close";
                    clicked => { root.close-viewer(); }
                }
            }

            Text {
                text: root.viewer-title;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            if !root.viewer-error.is-empty : Text {
                text: root.viewer-error;
                color: red;
                wrap: word-wrap;
            }

            // The page itself: tap the left/right half to flip pages within the
            // PDF, with a small page-number badge overlaid at the bottom.
            Rectangle {
                vertical-stretch: 1;

                Image {
                    source: root.page-image;
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                }

                // Tap zones: left 0-20% = prev page, right 80-100% = next page.
                // The middle 60% is intentionally inert for now.
                TouchArea {
                    x: 0;
                    width: parent.width * 20%;
                    height: 100%;
                    enabled: root.page-number > 1;
                    clicked => { root.prev-page(); }
                }
                TouchArea {
                    x: parent.width * 80%;
                    width: parent.width * 20%;
                    height: 100%;
                    enabled: root.page-number < root.page-count;
                    clicked => { root.next-page(); }
                }

                badge := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 8px;
                    width: pageLabel.preferred-width + 16px;
                    height: pageLabel.preferred-height + 6px;
                    background: #000000a0;
                    border-radius: 6px;
                    pageLabel := Text {
                        width: 100%;
                        height: 100%;
                        text: "Page \{root.page-number} / \{root.page-count}";
                        color: white;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
