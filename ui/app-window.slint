// ListView stays from std-widgets: it virtualizes its rows, which the Material
// library's ScrollView-based ListView does not, and our song lists can be long.
import { ListView } from "std-widgets.slint";
// Material Components (vendored in material-1.0/, registered as "@material" in
// build.rs). MaterialPalette drives colors and follows the system light/dark
// scheme; TabBar is the top tab strip; the buttons/TextField replace the old
// std-widgets ones the deprecated "material" style used to theme.
import {
    MaterialPalette,
    TabBar,
    NavigationItem,
    FilledButton,
    TonalButton,
    TextField,
} from "@material";

struct SongResult {
    title: string,
    subtitle: string, // book title · page
}

struct BookEntry {
    name: string, // book stem (no extension)
    title: string, // human-readable title (empty if the index has none)
    installed: bool, // PDF present (searchable now) vs index-only
}

struct SetlistEntry {
    name: string,
    song-count: int,
}

struct SetlistSongEntry {
    title: string,
    subtitle: string, // book title · page (the stem if no friendly title)
    available: bool, // matching PDF installed (else greyed, opens to a render error)
}

struct AnnotationItem {
    id: int,  // DB rowid, used to update position
    x: float, // normalized 0.0–1.0 within the page image
    y: float,
    text: string,
}

// Hairline dividers. HSeparator is a horizontal line (full width, 1px tall) for
// separating stacked rows; VSeparator is a vertical line (1px wide, full height)
// for separating side-by-side columns. Each leaves the other dimension to fill,
// so don't swap them — a fixed size on the wrong axis breaks the parent layout.
component HSeparator inherits Rectangle {
    height: 1px;
    background: #0000001a;
}

component VSeparator inherits Rectangle {
    width: 1px;
    background: #0000001a;
}

// A small square button whose glyph is a vector Path, not a font character.
// The Android system font (Roboto) has no ▲ ▼ ✕ glyphs, so a Button with those
// as text renders an empty-box tofu; a Path is drawn by the renderer and needs
// no font coverage. `commands` is SVG path data in a 24x24 viewbox; `filled`
// picks fill (triangles) vs stroke (the cross).
component IconButton inherits Rectangle {
    in property <string> commands;
    in property <bool> filled: true;
    in property <bool> enabled: true;
    // When true, the button paints with the accent background so a toggled-on
    // mode (e.g. add-text / move-annotation) is visually obvious.
    in property <bool> checked: false;
    // Defaults to the palette foreground (adapts to dark mode). Callers that
    // sit on a fixed-color surface (e.g. an annotation over the white PDF page)
    // can override this so the glyph stays readable.
    in property <color> icon-color: MaterialPalette.on-surface;
    callback clicked <=> ta.clicked;

    width: 44px;
    height: 36px;
    border-radius: 4px;
    border-width: 1px;
    border-color: MaterialPalette.on-surface.with-alpha(0.13);
    background: root.checked ? MaterialPalette.primary : !root.enabled ? MaterialPalette.on-surface.with-alpha(0.03) : ta.pressed ? MaterialPalette.on-surface.with-alpha(0.15) : ta.has-hover ? MaterialPalette.on-surface.with-alpha(0.08) : MaterialPalette.on-surface.with-alpha(0.04);
    opacity: root.enabled ? 1.0 : 0.35;

    ta := TouchArea {
        enabled: root.enabled;
    }
    Path {
        width: 22px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: root.filled ? root.icon-color : transparent;
        stroke: root.filled ? transparent : root.icon-color;
        stroke-width: 2.5px;
    }
}

// A row in a dropdown menu: checkmark on the left (visible when checked), text,
// hover highlight. Touchable — fires `clicked` regardless of checked state so
// the caller decides the toggle logic.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> checked: false;
    callback clicked();

    height: 48px;
    border-radius: 4px;
    background: ta.has-hover ? #0000000e : transparent;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        // Wrap the Path so the layout assigns it a row-height column;
        // we then center the fixed-size glyph vertically within it.
        Rectangle {
            width: 20px;
            Path {
                width: 20px;
                height: 20px;
                x: 0;
                y: (parent.height - self.height) / 2;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 5 13 L 10 18 L 19 7";
                fill: transparent;
                stroke: MaterialPalette.on-surface;
                stroke-width: 2.5px;
                opacity: root.checked ? 1.0 : 0.0;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-size: 16px;
        }
    }
}

// A modal dialog: a dimmed full-window scrim with a centered white card. Tapping
// the scrim outside the card fires `dismissed` (taps on the card are swallowed);
// the caller slots the card's content via @children, laid out in a padded
// vertical stack. Placed as a direct child of the window so it draws on top.
component MessageBox inherits Rectangle {
    callback dismissed();

    width: 100%;
    height: 100%;
    background: #00000080;

    TouchArea {
        clicked => { root.dismissed(); }
    }
    Rectangle {
        width: min(parent.width - 48px, 360px);
        height: card.preferred-height;
        background: MaterialPalette.background;
        border-radius: 8px;
        // Swallow taps on the card so they don't reach the scrim and dismiss.
        TouchArea { }
        card := VerticalLayout {
            padding: 20px;
            spacing: 16px;
            @children
        }
    }
}

// One row of a ListView: a hover highlight, the row content (laid out
// horizontally via @children), and a hairline bottom separator. Used by every
// list so rows read as discrete units instead of floating text.
component ListRow inherits Rectangle {
    height: content.preferred-height;
    background: hover.has-hover ? #00000008 : transparent;
    // Tapping the row body (not its buttons, which sit on top and grab their
    // own clicks) fires this; rows that want a default action connect it.
    callback clicked <=> hover.clicked;

    hover := TouchArea { }
    content := HorizontalLayout {
        padding: 8px;
        spacing: 6px;
        @children
    }
    HSeparator {
        y: parent.height - self.height;
        width: 100%;
    }
}

component ResultRow {
    in property <SongResult> data;
    callback clicked <=> touchArea.clicked;

    Rectangle {
        background: touchArea.has-hover ? #00000010 : transparent;
        touchArea := TouchArea {
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                Text {
                    text: data.title;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: data.subtitle;
                    color: gray;
                    font-size: 16px;
                    // Elide instead of demanding full width (a long book title
                    // must not push trailing buttons off-screen).
                    overflow: elide;
                }
            }
        }
        HSeparator {
            y: parent.height - self.height;
            width: 100%;
        }
    }
}

// The setlist being edited: its songs with reorder/remove controls. Factored
// out of the editor so the same pane can sit in a side-by-side column (wide
// screens) or stacked on top (narrow screens) without duplicating its content.
component SetlistColumn inherits VerticalLayout {
    in property <[SetlistSongEntry]> songs;
    callback move-up(int);
    callback move-down(int);
    callback remove(int);

    spacing: 4px;
    Text {
        text: "In this setlist";
        font-weight: 700;
    }
    list := ListView {
        vertical-stretch: 1;
        mouse-drag-pan-enabled: true;
        horizontal-scrollbar-policy: always-off;
        for song[i] in root.songs : ListRow {
            width: list.viewport-width;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: "\{i + 1}. \{song.title}";
                    font-weight: 700;
                    color: song.available ? MaterialPalette.on-surface : gray;
                    wrap: word-wrap;
                }
                Text {
                    text: song.available ? song.subtitle : "\{song.subtitle} — PDF missing";
                    color: song.available ? gray : #b00020;
                    font-size: 14px;
                    overflow: elide;
                }
            }
            // Reorder/remove grouped tightly so they read as one control
            // cluster for this row.
            HorizontalLayout {
                spacing: 2px;
                IconButton {
                    commands: "M 12 7 L 19 17 L 5 17 Z";
                    enabled: i > 0;
                    clicked => { root.move-up(i); }
                }
                IconButton {
                    commands: "M 5 7 L 19 7 L 12 17 Z";
                    enabled: i < root.songs.length - 1;
                    clicked => { root.move-down(i); }
                }
                IconButton {
                    commands: "M 7 7 L 17 17 M 7 17 L 17 7";
                    filled: false;
                    clicked => { root.remove(i); }
                }
            }
        }
    }
}

// Live song search to add to the setlist. The field is always visible (no
// toggle); Preview opens the song in the viewer so the user isn't choosing
// blind. Factored out for the same wide/narrow reuse as SetlistColumn.
component AddSongsColumn inherits VerticalLayout {
    in property <[SongResult]> results;
    callback search(string);
    callback preview(int);
    callback add(int);

    spacing: 4px;
    TextField {
        vertical-stretch: 0;
        // `label` is the visible (floating) hint; placeholder-text is only used
        // by this component for accessibility, never drawn.
        label: @tr("Search songs to add");
        placeholder-text: @tr("Search songs to add");
        edited(text) => { root.search(text); }
    }
    Rectangle {
        vertical-stretch: 1;
        list := ListView {
            mouse-drag-pan-enabled: true;
            horizontal-scrollbar-policy: always-off;
            for r[ri] in root.results : ListRow {
                width: list.viewport-width;
                // Tapping the row previews the song in the viewer (choose before
                // committing); the explicit button adds it to the setlist.
                clicked => { root.preview(ri); }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: r.title;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        text: r.subtitle;
                        color: gray;
                        font-size: 16px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    TonalButton {
                        text: "Add";
                        clicked => { root.add(ri); }
                    }
                }
            }
        }
        // Guidance while no search has been run yet.
        if root.results.length == 0 : Text {
            width: 100%;
            height: 100%;
            text: "Type above to find songs to add.";
            color: gray;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component AppWindow inherits Window {
    title: "TuneCall";
    default-font-size: 20px;
    // No fixed preferred-width/height: on Android they made the window size to
    // the layout instead of filling the screen (search field hidden until a
    // resize/maximize forced a relayout). See slint-ui/slint#11170, #5391.

    // --- top-level tabs ---
    // 0 = Search, 1 = Setlists, 2 = Books. Rust sets it at startup (Books when
    // nothing is installed yet, to guide first-time setup; Search otherwise).
    in-out property <int> active-tab;

    // --- search ---
    in property <[SongResult]> results;
    in property <string> status;
    // When true, `status` holds an error (e.g. a failed Reload) and is shown red.
    in property <bool> status-error;
    callback search(string);
    callback open-result(int); // index into `results`
    callback reload();
    // Local rescan (no network): rebuilds the library and Books-tab state after
    // a SAF import lands new PDFs. Fired from the JNI callback.
    callback refresh-installed();

    // --- books list (setup-time: which PDFs are indexed/supported) ---
    in property <[BookEntry]> book-list;
    // Open an installed book in the viewer at page 1, for free-form paging.
    callback open-book(int); // index into `book-list`
    // Folder to drop PDFs into, shown on the Books tab so users can add books even
    // after Reload populates the library. The instruction wording below switches on
    // the built-in `Platform.os`: iOS exposes the folder via the Files app / Finder
    // (and its raw sandbox path is meaningless, so it isn't shown there); elsewhere
    // it's a USB-reachable filesystem path.
    in property <string> pdf-dir;
    // Whether the "Import from folder…" button applies here. Android-only: SAF
    // has no equivalent on desktop.
    in property <bool> import-supported;
    callback import-folder();
    in property <string> about; // app name, version and build (footer of the Books tab)
    // Opt-in debug logging (Books tab). Reflects the saved setting; the callback
    // persists a change. Takes effect on the next app launch.
    in-out property <bool> file-logging;
    callback set-file-logging(bool);
    // Folder the log file is written to (Rust sets it to the data dir). Shown in
    // a one-time dialog when logging is switched on, so the user knows where to
    // find the file (over USB) without parking the path on the Books screen.
    in property <string> log-dir;
    property <bool> show-log-info;
    // Full-window log viewer for on-device debugging (menu > "View log"). The
    // menu item populates the two section properties then flips this to true.
    // Kept as two properties (crash-buffer + file log) so their Copy buttons
    // can grab just their own chunk — needed because Slint's Android text
    // selection is limited: handles don't extend inside a scrolling parent.
    property <bool> show-log-viewer;
    property <string> log-crash;
    property <string> log-file;
    // Empty when the section is unavailable (no crash entries, or file log
    // disabled), so the caller can hide the section's Copy button.
    callback read-crash-log() -> string;
    callback read-file-log() -> string;
    property <bool> menu-open: false;
    // Reverse-color (white-on-black) rendering of the PDF page. Only affects
    // the viewer's page image; the rest of the app follows the system theme.
    // Persisted by Rust on toggle; reflected here at startup.
    in-out property <bool> viewer-inverted: false;
    callback set-viewer-inverted(bool);

    // --- setlists ---
    in property <[SetlistEntry]> setlists;
    in property <int> editing-index: -1; // -1 = list view, >=0 = editing that setlist
    in property <string> editing-name; // name of the setlist being edited
    in property <[SetlistSongEntry]> editing-songs;
    in property <[SongResult]> add-results; // search hits while adding songs
    callback create-setlist(string);
    callback rename-setlist(int/* index */, string/* new name */);
    callback delete-setlist(int);
    // Delete is guarded by a confirmation dialog (an accidental tap on a phone
    // would otherwise wipe a setlist). -1 = no dialog; >=0 = confirming that
    // index, with its name held alongside for the prompt.
    property <int> confirm-delete-index: -1;
    property <string> confirm-delete-name;
    callback edit-setlist(int); // enter the editor
    callback close-setlist-editor();
    callback play-setlist(int); // open the setlist in the viewer
    callback setlist-add-search(string);
    callback setlist-add-song(int); // index into `add-results`
    callback preview-song(int); // preview `add-results[i]` in the viewer before adding
    callback setlist-remove-song(int); // index into `editing-songs`
    callback setlist-move-up(int);
    callback setlist-move-down(int);

    // --- viewer ---
    in property <bool> viewer-visible: false;
    in property <string> viewer-title;
    in property <image> page-image;
    in property <int> page-number;
    in property <int> page-count;
    in property <int> result-index; // 0-based position of the open song in the nav list
    in property <int> result-count; // total number of songs being navigated
    in property <string> viewer-error;
    // When the viewer was opened by previewing setlist add-search hits, it
    // offers an Add button so the chosen song goes straight into the setlist
    // (no need to remember it and find it again in the list). `viewer-added`
    // flips to true once the current song is added and resets on navigation,
    // so the button can confirm and avoid silent duplicate taps.
    in property <bool> viewer-add-mode;
    in property <bool> viewer-added;
    callback viewer-add-song();
    // Zoom state (pinch / ctrl+wheel / double-tap). 1.0 = fit the page area;
    // the pan offsets are the zoomed page's position inside it (always <= 0).
    // Page flips keep the zoom (a margin crop survives across pages); Rust
    // resets all three when a different song is opened.
    in-out property <float> viewer-zoom: 1.0;
    in-out property <length> viewer-pan-x;
    in-out property <length> viewer-pan-y;
    callback render-zoomed(float); // re-rasterize the page to suit this zoom
    callback prev-page(); // within the open PDF
    callback next-page();
    callback prev-result(); // across the nav list (search results or a setlist)
    callback next-result();
    property <bool> edit-mode: false;
    property <bool> adding-text: false;
    property <bool> moving-annotations: false;
    in-out property <[AnnotationItem]> page-annotations;
    property <float> pending-ann-x;
    property <float> pending-ann-y;
    property <string> annotation-text;
    property <bool> annotation-dialog-open: false;
    callback save-annotation(float, float, string);
    callback move-annotation(int, float, float); // rowid, new-x, new-y (normalized)
    callback delete-annotation(int);             // rowid
    // Top-row visibility inside the viewer. A center tap toggles it (along with
    // the bottom page badge) so the page fills the screen while playing.
    property <bool> toolbar-shown: true;
    callback close-viewer();
    // Ask the platform to go fullscreen (hide the status/nav bars) while the
    // viewer is open and restore them when it closes. Android-only; a no-op
    // elsewhere. Hiding the bars drops safe-area-insets to 0, so the viewer's
    // inset padding reclaims the freed space.
    callback set-immersive(bool);

    // On Android the search field keeps focus while the viewer covers it, so its
    // text caret/selection handles bleed through over the PDF. Drop focus while
    // the viewer is up and restore it (only on the Search tab) when we return.
    changed viewer-visible => {
        root.set-immersive(root.viewer-visible);
        if (root.viewer-visible) {
            // A freshly opened viewer always starts with chrome visible — the
            // hide is an explicit center tap, and shouldn't carry over from the
            // previous viewing session.
            root.toolbar-shown = true;
            searchField.clear-focus();
        } else if (root.active-tab == 0) {
            searchField.focus();
        }
    }

    // Slint drops focus when a tab is switched away (on purpose), so coming back
    // to the Search tab leaves the search field un-focused — the user then has
    // to tap it before the keyboard reappears. Restore focus on tab change so
    // typing works straight away. The Setlists tab's leading TextField is
    // handled in its own `if` block below (the ids aren't in scope here).
    changed active-tab => {
        if (root.active-tab == 0) {
            searchField.focus();
        }
    }

    // Fill behind the system bars so their reserved strips show the app
    // background, not a gap left by the inset tab UI below.
    Rectangle {
        width: 100%;
        height: 100%;
        background: MaterialPalette.background;
    }

    // Keep the tab UI clear of the status bar (top), nav bar (bottom) and notch.
    // Unlike the viewer (which goes fullscreen), the tabs are an interactive
    // browsing surface, so we reserve the bar space rather than draw behind it.
    // Insets are 0 on desktop and where a bar autohides.
    Rectangle {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;

        VerticalLayout {
            // Material top tab strip with the settings burger to its right, so
            // the button doesn't cover the last tab (Books) — the TabBar splits
            // its width evenly across items, and a floated button used to land
            // on top of the rightmost one. The three tab bodies below are
            // stacked and toggled by visibility (not `if`): keeping them all
            // instantiated means searchField stays in scope for the focus
            // handlers above.
            HorizontalLayout {
                TabBar {
                    current-index <=> root.active-tab;
                    horizontal-stretch: 1;
                    items: [
                        { text: "Search" },
                        { text: "Setlists" },
                        { text: "Books" },
                    ];
                }
                // Center the fixed-size button vertically in the tab strip.
                VerticalLayout {
                    alignment: center;
                    padding-left: 4px;
                    padding-right: 4px;
                    IconButton {
                        commands: "M 3 7 L 21 7 M 3 12 L 21 12 M 3 17 L 21 17";
                        filled: false;
                        clicked => { root.menu-open = !root.menu-open; }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;

                // --- Search tab ---
                VerticalLayout {
                    visible: root.active-tab == 0;
                    width: 100%;
                    height: 100%;
                    padding: 8px;
                    spacing: 8px;

                    searchField := TextField {
                        // TextField's root is a layout, so it would otherwise absorb
                        // the column's spare height; keep it at its preferred height
                        // and let resultsList take the rest.
                        vertical-stretch: 0;
                        // `label` is the visible (floating) hint; placeholder-text
                        // is only used by this component for accessibility.
                        label: @tr("Search songs");
                        placeholder-text: @tr("Search songs");
                        edited(text) => { root.search(text); }
                    }

                    Text {
                        text: root.status;
                        color: root.status-error ? #cc0000 : gray;
                        font-weight: root.status-error ? 700 : 400;
                        wrap: word-wrap;
                    }

                    resultsList := ListView {
                        vertical-stretch: 1;
                        mouse-drag-pan-enabled: true;
                        horizontal-scrollbar-policy: always-off;
                        for result[idx] in root.results : ResultRow {
                            data: result;
                            width: resultsList.viewport-width;
                            clicked => { root.open-result(idx); }
                        }
                    }
                }

                // --- Setlists tab ---
                Rectangle {
                    visible: root.active-tab == 1;
                    width: 100%;
                    height: 100%;
                    // List view: every setlist, with create / play / edit / delete.
                    if root.editing-index < 0 : VerticalLayout {
                        padding: 8px;
                        spacing: 8px;

                        // Local mirror of active-tab so we can watch it from a
                        // `changed` handler in this scope: `newName` sits inside
                        // this `if` block and isn't visible to a root-level
                        // handler. Fires when the user switches back to this tab.
                        property <int> tab-signal: root.active-tab;
                        changed tab-signal => {
                            if (self.tab-signal == 1) {
                                newName.focus();
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            newName := TextField {
                                label: "New setlist name";
                                placeholder-text: "New setlist name";
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                FilledButton {
                                    text: "Create";
                                    enabled: newName.text != "";
                                    clicked => {
                                        root.create-setlist(newName.text);
                                        newName.text = "";
                                    }
                                }
                            }
                        }

                        setlistsList := ListView {
                            vertical-stretch: 1;
                            mouse-drag-pan-enabled: true;
                            horizontal-scrollbar-policy: always-off;
                            for s[idx] in root.setlists : ListRow {
                                width: setlistsList.viewport-width;
                                // Tapping a non-empty setlist plays it; Edit/Delete
                                // stay as explicit buttons. An empty one can't play,
                                // so its row tap is a no-op (use Edit to add songs).
                                clicked => {
                                    if (s.song-count > 0) {
                                        root.play-setlist(idx);
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: s.name;
                                        font-weight: 700;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: "\{s.song-count} song(s)";
                                        color: gray;
                                        font-size: 16px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    TonalButton {
                                        text: "Edit";
                                        clicked => { root.edit-setlist(idx); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    TonalButton {
                                        text: "Delete";
                                        clicked => {
                                            root.confirm-delete-name = s.name;
                                            root.confirm-delete-index = idx;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Editor view: rename/close on top, then two columns — the
                    // setlist (reorder/remove) on the left, a live song search with
                    // preview/add on the right (Mobile Sheets style).
                    if root.editing-index >= 0 : VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        // See the list-view branch: needed because editName lives
                        // inside this `if` block and can't be reached from a
                        // root-level `changed active-tab` handler.
                        property <int> tab-signal: root.active-tab;
                        changed tab-signal => {
                            if (self.tab-signal == 1) {
                                editName.focus();
                            }
                        }

                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 8px;
                            // The name applies live as you type (no separate Rename
                            // button to forget). Rust skips empty input, so clearing
                            // the field to retype never wipes the stored name; it also
                            // doesn't write the name back here, so the caret is stable.
                            editName := TextField {
                                label: "Setlist name";
                                text: root.editing-name;
                                horizontal-stretch: 1;
                                edited(text) => { root.rename-setlist(root.editing-index, text); }
                            }
                            VerticalLayout {
                                alignment: center;
                                TonalButton {
                                    text: "Close";
                                    clicked => { root.close-setlist-editor(); }
                                }
                            }
                        }

                        // Wide (tablet): setlist and add-search side by side. Narrow
                        // (phone): stacked, setlist on top and add-search below — a
                        // horizontal split below ~700px squeezes each pane so thin
                        // that every title wraps one character per line.
                        if root.width >= 700px : HorizontalLayout {
                            vertical-stretch: 1;
                            spacing: 12px;
                            SetlistColumn {
                                horizontal-stretch: 1;
                                songs: root.editing-songs;
                                move-up(i) => { root.setlist-move-up(i); }
                                move-down(i) => { root.setlist-move-down(i); }
                                remove(i) => { root.setlist-remove-song(i); }
                            }
                            VSeparator { }
                            AddSongsColumn {
                                horizontal-stretch: 1;
                                results: root.add-results;
                                search(t) => { root.setlist-add-search(t); }
                                preview(i) => { root.preview-song(i); }
                                add(i) => { root.setlist-add-song(i); }
                            }
                        }
                        if root.width < 700px : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;
                            // Give the add-search pane twice the height of the setlist
                            // pane (~33/66): its search field summons the virtual
                            // keyboard, which would otherwise cover an even split's
                            // results.
                            SetlistColumn {
                                vertical-stretch: 1;
                                songs: root.editing-songs;
                                move-up(i) => { root.setlist-move-up(i); }
                                move-down(i) => { root.setlist-move-down(i); }
                                remove(i) => { root.setlist-remove-song(i); }
                            }
                            HSeparator { }
                            AddSongsColumn {
                                vertical-stretch: 2;
                                results: root.add-results;
                                search(t) => { root.setlist-add-search(t); }
                                preview(i) => { root.preview-song(i); }
                                add(i) => { root.setlist-add-song(i); }
                            }
                        }
                    }
                }

                // --- Books tab ---
                // Setup-time: every indexed book, marking whether its PDF is
                // installed. PDFs are not bundled (copyright), so this tells the user
                // which PDFs they can install to enable a book.
                VerticalLayout {
                    visible: root.active-tab == 2;
                    width: 100%;
                    height: 100%;
                    padding: 8px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Supported books";
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.import-supported : TonalButton {
                            text: "Import";
                            clicked => { root.import-folder(); }
                        }
                        TonalButton {
                            text: "Reload";
                            clicked => { root.reload(); }
                        }
                    }

                    Text {
                        text: "Reload fetches the latest indexes. Install the matching PDF to enable a book; PDFs are not bundled.";
                        color: gray;
                        font-size: 16px;
                        wrap: word-wrap;
                    }

                    // Always-visible installation instructions. PDFs aren't
                    // shipped, so even when Reload has populated the library the
                    // user still needs to know where to drop additional books.
                    Text {
                        text: Platform.os == OperatingSystemType.ios
                            ? "To add PDFs: open the Files app → On My iPad/iPhone → TuneCall, or connect to a Mac (Finder → device → Files → TuneCall). Then tap Reload."
                            : "To add a PDF, copy it via USB to:\n\{root.pdf-dir}";
                        color: gray;
                        font-size: 16px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.status;
                        color: root.status-error ? #cc0000 : gray;
                        font-weight: root.status-error ? 700 : 400;
                        font-size: 16px;
                        wrap: word-wrap;
                    }

                    booksList := ListView {
                        vertical-stretch: 1;
                        mouse-drag-pan-enabled: true;
                        horizontal-scrollbar-policy: always-off;
                        for book[idx] in root.book-list : ListRow {
                            width: booksList.viewport-width;
                            // Tapping an installed book opens it in the viewer at
                            // page 1 for free-form paging. Missing PDFs are a
                            // no-op (nothing to render).
                            clicked => {
                                if (book.installed) {
                                    root.open-book(idx);
                                }
                            }
                            // Title (from the index) on top, file stem underneath in
                            // gray. When the index carries no title, the stem is the
                            // only name we have, so it stands in as the main line.
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: book.title != "" ? book.title : book.name;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }
                                if book.title != "" : Text {
                                    text: book.name;
                                    color: gray;
                                    font-size: 16px;
                                    wrap: word-wrap;
                                }
                            }
                            Text {
                                text: book.installed ? "installed" : "PDF missing";
                                color: book.installed ? #2e7d32 : gray;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // App name / version / build, parked at the bottom so it's
                    // available for bug reports without being intrusive.
                    Text {
                        text: root.about;
                        color: gray;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // Viewer overlay (covers the whole window, tab bar included, when a song is
    // open). A later sibling than the tab UI, so it draws on top.
    if root.viewer-visible : Rectangle {
        width: root.width;
        height: root.height;
        background: MaterialPalette.background;

        VerticalLayout {
            // Keep the content (toolbar, page badge) clear of the system bars.
            // The overlay draws edge-to-edge, so on a phone with on-screen nav
            // buttons the bottom badge would otherwise sit behind them. Insets
            // are 0 on desktop and where there is no notch/bar. The white
            // Rectangle still fills behind the bars so they sit on white, not a
            // gap.
            padding-left: 8px + root.safe-area-insets.left;
            padding-right: 8px + root.safe-area-insets.right;
            padding-top: 8px + root.safe-area-insets.top;
            padding-bottom: 8px + root.safe-area-insets.bottom;
            spacing: 6px;

            // Top bar navigates the nav list (the search hits for a song, or the
            // songs of a setlist), so you can step through without going back.
            // Hidden by a center tap on the page for distraction-free playing;
            // tap the center again to bring it back.
            if root.toolbar-shown : HorizontalLayout {
                spacing: 8px;
                TonalButton {
                    text: "‹ Prev";
                    enabled: root.result-index > 0;
                    clicked => { root.prev-result(); }
                }
                Text {
                    text: "\{root.result-index + 1} / \{root.result-count}";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.edit-mode : IconButton {
                    // "T" — insert text annotation
                    commands: "M 5 5 L 5 8 L 10.5 8 L 10.5 19 L 13.5 19 L 13.5 8 L 19 8 L 19 5 Z";
                    checked: root.adding-text;
                    clicked => {
                        root.adding-text = !root.adding-text;
                        root.moving-annotations = false;
                    }
                }
                if root.edit-mode : IconButton {
                    // Four-directional move arrow
                    commands: "M 12 2 L 9 5 L 11 5 L 11 11 L 5 11 L 5 9 L 2 12 L 5 15 L 5 13 L 11 13 L 11 19 L 9 19 L 12 22 L 15 19 L 13 19 L 13 13 L 19 13 L 19 15 L 22 12 L 19 9 L 19 11 L 13 11 L 13 5 L 15 5 Z";
                    checked: root.moving-annotations;
                    clicked => {
                        root.moving-annotations = !root.moving-annotations;
                        root.adding-text = false;
                    }
                }
                TonalButton {
                    text: root.edit-mode ? "Done" : "Edit";
                    clicked => {
                        root.edit-mode = !root.edit-mode;
                        root.adding-text = false;
                        root.moving-annotations = false;
                    }
                }
                TonalButton {
                    text: "Next ›";
                    enabled: root.result-index < root.result-count - 1;
                    clicked => { root.next-result(); }
                }
                if root.viewer-add-mode : FilledButton {
                    text: root.viewer-added ? "Added" : "Add";
                    enabled: !root.viewer-added;
                    clicked => { root.viewer-add-song(); }
                }
                TonalButton {
                    text: "Close";
                    // Reset edit state too — next song open shouldn't inherit
                    // a stale toolbar mode from this one.
                    clicked => {
                        root.edit-mode = false;
                        root.adding-text = false;
                        root.moving-annotations = false;
                        root.close-viewer();
                    }
                }
                // Same burger glyph as the tab-bar's settings button, opens the
                // same dropdown. The tab-bar button is hidden behind the viewer
                // overlay, so the viewer carries its own.
                IconButton {
                    commands: "M 3 7 L 21 7 M 3 12 L 21 12 M 3 17 L 21 17";
                    filled: false;
                    clicked => { root.menu-open = !root.menu-open; }
                }
            }

            if !root.viewer-error.is-empty : Text {
                text: root.viewer-error;
                color: red;
                wrap: word-wrap;
            }

            // The page itself: tap the left/right half to flip pages within the
            // PDF, with a small page-number badge overlaid at the bottom.
            // Pinch (or ctrl+wheel, or double-tap) zooms; a single finger pans
            // while zoomed in.
            pageArea := Rectangle {
                vertical-stretch: 1;
                clip: true; // the zoomed page must not paint over the toolbar

                // Gesture-start state, so every update rescales from the start
                // values instead of accumulating per-frame rounding drift.
                property <float> start-zoom: 1.0;
                property <length> start-pan-x;
                property <length> start-pan-y;

                // The bottom badge covers the last line of music on some scans,
                // so it auto-hides a few seconds after the page changes and is
                // toggled back by a tap in the page's center. `badge-page` mirrors
                // page-number only so its `changed` handler fires on navigation
                // (open, page flip, or song change) — re-showing the badge and
                // restarting the fade each time.
                property <bool> badge-shown: true;
                property <int> badge-page: root.page-number;
                changed badge-page => {
                    self.badge-shown = true;
                    badgeHideTimer.restart();
                }
                badgeHideTimer := Timer {
                    interval: 5s;
                    running: true;
                    triggered => {
                        self.running = false;
                        pageArea.badge-shown = false;
                    }
                }

                // Zoom to `new-zoom` (clamped) keeping the page point under
                // (cx, cy) fixed on screen. old-* is the state the new zoom is
                // relative to (gesture start, or the current state for wheel).
                function zoom-to(new-zoom: float, cx: length, cy: length,
                                 old-zoom: float, old-pan-x: length, old-pan-y: length) {
                    root.viewer-zoom = clamp(new-zoom, 1.0, 4.0);
                    root.viewer-pan-x = cx - (cx - old-pan-x) * root.viewer-zoom / old-zoom;
                    root.viewer-pan-y = cy - (cy - old-pan-y) * root.viewer-zoom / old-zoom;
                    self.clamp-pan();
                    hiresTimer.restart();
                }
                // Keep the zoomed page covering the whole area (no gaps).
                function clamp-pan() {
                    root.viewer-pan-x = clamp(root.viewer-pan-x, self.width * (1 - root.viewer-zoom), 0px);
                    root.viewer-pan-y = clamp(root.viewer-pan-y, self.height * (1 - root.viewer-zoom), 0px);
                }

                // Re-rasterize sharper shortly after the zoom settles, not on
                // every pinch frame (rendering is synchronous).
                hiresTimer := Timer {
                    interval: 300ms;
                    running: false;
                    triggered => {
                        self.running = false;
                        root.render-zoomed(root.viewer-zoom);
                    }
                }

                gesture := ScaleRotateGestureHandler {
                    started => {
                        pageArea.start-zoom = root.viewer-zoom;
                        pageArea.start-pan-x = root.viewer-pan-x;
                        pageArea.start-pan-y = root.viewer-pan-y;
                    }
                    updated => {
                        pageArea.zoom-to(pageArea.start-zoom * self.scale,
                                         self.center.x, self.center.y,
                                         pageArea.start-zoom, pageArea.start-pan-x, pageArea.start-pan-y);
                    }

                    Image {
                        source: root.page-image;
                        image-fit: contain;
                        x: root.viewer-pan-x;
                        y: root.viewer-pan-y;
                        width: parent.width * root.viewer-zoom;
                        height: parent.height * root.viewer-zoom;
                    }

                    // One surface for all single-pointer interaction: drag to
                    // pan while zoomed in, tap the left/right 20% to flip pages
                    // (at any zoom — a margin crop must not block page turns),
                    // double-tap the middle to zoom in/out, ctrl+wheel to zoom
                    // on desktop. Tap vs drag is decided by movement distance.
                    panArea := TouchArea {
                        property <length> press-pan-x;
                        property <length> press-pan-y;
                        // The release of a pan drag also fires `clicked`; only
                        // treat it as a tap if the pointer barely moved.
                        pure function is-tap() -> bool {
                            Math.abs((self.mouse-x - self.pressed-x) / 1px) < 8
                                && Math.abs((self.mouse-y - self.pressed-y) / 1px) < 8
                        }
                        changed pressed => {
                            if (self.pressed) {
                                self.press-pan-x = root.viewer-pan-x;
                                self.press-pan-y = root.viewer-pan-y;
                            }
                        }
                        moved => {
                            if (root.viewer-zoom > 1.0) {
                                root.viewer-pan-x = self.press-pan-x + (self.mouse-x - self.pressed-x);
                                root.viewer-pan-y = self.press-pan-y + (self.mouse-y - self.pressed-y);
                                pageArea.clamp-pan();
                            }
                        }
                        clicked => {
                            if (self.is-tap()) {
                                if (root.adding-text) {
                                    root.pending-ann-x = (self.pressed-x - root.viewer-pan-x) / 1px / (pageArea.width * root.viewer-zoom / 1px);
                                    root.pending-ann-y = (self.pressed-y - root.viewer-pan-y) / 1px / (pageArea.height * root.viewer-zoom / 1px);
                                    root.annotation-text = "";
                                    root.annotation-dialog-open = true;
                                    root.adding-text = false;
                                } else if (self.pressed-x < self.width * 20% && root.page-number > 1) {
                                    root.prev-page();
                                } else if (self.pressed-x > self.width * 80% && root.page-number < root.page-count) {
                                    root.next-page();
                                } else if (self.pressed-x >= self.width * 20% && self.pressed-x <= self.width * 80%) {
                                    // Center tap: toggle the top toolbar and the
                                    // bottom badge together. Hiding both clears the
                                    // chrome for distraction-free reading; tap again
                                    // to restore. The auto-hide timer is stopped so
                                    // the explicit choice sticks.
                                    root.toolbar-shown = !root.toolbar-shown;
                                    pageArea.badge-shown = root.toolbar-shown;
                                    badgeHideTimer.running = false;
                                }
                            }
                        }
                        double-clicked => {
                            // Middle 60% only: a double-tap on an edge zone is
                            // two page flips, not a zoom toggle.
                            if (self.pressed-x >= self.width * 20% && self.pressed-x <= self.width * 80%) {
                                if (root.viewer-zoom > 1.0) {
                                    pageArea.zoom-to(1.0, self.mouse-x, self.mouse-y,
                                                     root.viewer-zoom, root.viewer-pan-x, root.viewer-pan-y);
                                } else {
                                    pageArea.zoom-to(2.5, self.mouse-x, self.mouse-y, 1.0, 0px, 0px);
                                }
                            }
                        }
                        scroll-event(e) => {
                            if (e.modifiers.control) {
                                pageArea.zoom-to(root.viewer-zoom * (e.delta-y > 0 ? 1.1 : 1 / 1.1),
                                                 self.mouse-x, self.mouse-y,
                                                 root.viewer-zoom, root.viewer-pan-x, root.viewer-pan-y);
                                return accept;
                            }
                            reject
                        }
                    }

                    // Annotation overlay — after panArea so these touch areas
                    // sit on top and capture drags in move mode.
                    for ann in root.page-annotations : Rectangle {
                        property <length> drag-dx: 0px;
                        property <length> drag-dy: 0px;

                        x: root.viewer-pan-x + ann.x * pageArea.width * root.viewer-zoom + self.drag-dx;
                        y: root.viewer-pan-y + ann.y * pageArea.height * root.viewer-zoom + self.drag-dy;
                        width: ann-row.preferred-width + 8px;
                        height: ann-row.preferred-height + 4px;
                        border-radius: root.moving-annotations ? 3px : 0px;
                        border-width: root.moving-annotations ? 1px : 0px;
                        border-color: #0d47a1;

                        // Drag area declared first so the delete button (in ann-row,
                        // declared after) is painted on top and captures its own clicks.
                        ann-drag := TouchArea {
                            enabled: root.moving-annotations;
                            mouse-cursor: root.moving-annotations ? MouseCursor.move : MouseCursor.default;
                            // The parent Rectangle moves as drag-{dx,dy} change,
                            // so this TouchArea moves with it. After the parent
                            // shifts, mouse-x is in the new local frame while
                            // pressed-x is still in the press-time frame —
                            // (mouse-x - pressed-x) is the delta since the last
                            // `moved`, not since press. Accumulate to get the
                            // total drag.
                            moved => {
                                parent.drag-dx += self.mouse-x - self.pressed-x;
                                parent.drag-dy += self.mouse-y - self.pressed-y;
                            }
                            changed pressed => {
                                if (!self.pressed) {
                                    if (Math.abs(parent.drag-dx / 1px) > 4 || Math.abs(parent.drag-dy / 1px) > 4) {
                                        root.move-annotation(
                                            ann.id,
                                            ann.x + parent.drag-dx / 1px / (pageArea.width * root.viewer-zoom / 1px),
                                            ann.y + parent.drag-dy / 1px / (pageArea.height * root.viewer-zoom / 1px));
                                    }
                                    parent.drag-dx = 0px;
                                    parent.drag-dy = 0px;
                                }
                            }
                        }

                        ann-row := HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 4px;
                            ann-label := Text {
                                text: ann.text;
                                color: #0d47a1;
                                font-size: 18px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            // Wrap so the layout slot stretches to ann-row's
                            // height (the label is taller than the button) and
                            // the fixed-size IconButton is centered inside it.
                            if root.moving-annotations : Rectangle {
                                width: 20px;
                                IconButton {
                                    width: 20px;
                                    height: 20px;
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    commands: "M 7 7 L 17 17 M 7 17 L 17 7";
                                    filled: false;
                                    icon-color: #0d47a1;
                                    clicked => { root.delete-annotation(ann.id); }
                                }
                            }
                        }
                    }
                }

                badge := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 8px;
                    width: badgeRow.preferred-width + 16px;
                    height: badgeRow.preferred-height + 6px;
                    background: #000000a0;
                    border-radius: 6px;
                    opacity: pageArea.badge-shown ? 1.0 : 0.0;
                    // Hide-only fade: showing is instant (0ms) so a tap feels
                    // responsive; the auto-hide and tap-dismiss fade out gently.
                    animate opacity { duration: pageArea.badge-shown ? 0ms : 300ms; }
                    // Book name (dimmed, so it stays unobtrusive) and page number
                    // share the badge, saving the vertical space a separate title
                    // line would take.
                    badgeRow := HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.viewer-title;
                            color: #ffffff99;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "· Page \{root.page-number} / \{root.page-count}";
                            color: white;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Annotation text-entry dialog: shown when the user taps in add-text mode.
    // Appears on top of the viewer; OK fires save-annotation with the typed text.
    if root.annotation-dialog-open : Rectangle {
        // Focus the input as soon as the dialog appears — the user just tapped
        // a page location to summon it, and is about to type.
        init => { ann-input.focus(); }
        width: root.width;
        height: root.height;
        background: #00000060;
        TouchArea {
            clicked => { root.annotation-dialog-open = false; }
        }
        Rectangle {
            width: min(320px, root.width - 32px);
            height: card.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: MaterialPalette.background;
            border-radius: 8px;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;
            // Swallow taps on the dialog so they don't dismiss via the scrim.
            TouchArea { }
            card := VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text {
                    text: "Add note";
                    font-size: 16px;
                    font-weight: 700;
                    color: MaterialPalette.on-surface;
                }
                ann-input := TextField {
                    label: "Note";
                    text <=> root.annotation-text;
                    accepted => {
                        if (root.annotation-text != "") {
                            root.save-annotation(root.pending-ann-x, root.pending-ann-y, root.annotation-text);
                        }
                        root.annotation-dialog-open = false;
                        root.annotation-text = "";
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    TonalButton {
                        text: "Cancel";
                        horizontal-stretch: 1;
                        clicked => {
                            root.annotation-dialog-open = false;
                            root.annotation-text = "";
                        }
                    }
                    FilledButton {
                        text: "OK";
                        horizontal-stretch: 1;
                        clicked => {
                            if (root.annotation-text != "") {
                                root.save-annotation(root.pending-ann-x, root.pending-ann-y, root.annotation-text);
                            }
                            root.annotation-dialog-open = false;
                            root.annotation-text = "";
                        }
                    }
                }
            }
        }
    }

    // Confirm-before-delete dialog for a setlist. A later sibling than the
    // tab UI so it draws on top; tapping outside the card cancels (same as
    // the Cancel button).
    if root.confirm-delete-index >= 0 : MessageBox {
        dismissed => { root.confirm-delete-index = -1; }
        Text {
            text: "Delete \"\{root.confirm-delete-name}\"?";
            font-weight: 700;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            spacing: 8px;
            TonalButton {
                text: "Cancel";
                horizontal-stretch: 1;
                clicked => { root.confirm-delete-index = -1; }
            }
            FilledButton {
                text: "Delete";
                horizontal-stretch: 1;
                clicked => {
                    root.delete-setlist(root.confirm-delete-index);
                    root.confirm-delete-index = -1;
                }
            }
        }
    }

    // One-time info shown when debug logging is switched on from the settings menu:
    // tells the user where the log file lands and that it's reachable over USB.
    if root.show-log-info : MessageBox {
        dismissed => { root.show-log-info = false; }
        Text {
            text: "Debug logging on";
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "After you restart the app, a log file is written to:\n\n\{root.log-dir}\n\nConnect the device by USB to copy it off for a bug report.";
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        FilledButton {
            text: "OK";
            clicked => { root.show-log-info = false; }
        }
    }

    // Settings dropdown menu. Declared last so it draws on top of everything —
    // including the viewer overlay — since the viewer has its own burger button
    // that triggers this same menu.
    if root.menu-open : Rectangle {
        width: root.width;
        height: root.height;
        background: transparent;
        // Scrim: tap outside the panel to close.
        TouchArea {
            clicked => { root.menu-open = false; }
        }
        // Panel — declared after the scrim so it draws on top.
        Rectangle {
            x: root.width - root.safe-area-insets.right - self.width - 4px;
            y: root.safe-area-insets.top + 42px;
            width: min(260px, root.width - 16px);
            height: menu-vl.preferred-height;
            border-radius: 8px;
            background: MaterialPalette.background;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000030;
            border-width: 1px;
            border-color: #0000001a;
            // Swallow touches on the panel background so they don't reach the scrim.
            TouchArea { }
            menu-vl := VerticalLayout {
                padding: 4px;
                MenuItem {
                    // Suffix makes it clear this only flips the PDF page, not
                    // the whole app (which follows the system theme).
                    text: "Invert PDF colors (viewer)";
                    checked: root.viewer-inverted;
                    clicked => {
                        root.viewer-inverted = !root.viewer-inverted;
                        root.set-viewer-inverted(root.viewer-inverted);
                        root.menu-open = false;
                    }
                }
                MenuItem {
                    text: "Debug logging";
                    checked: root.file-logging;
                    clicked => {
                        root.file-logging = !root.file-logging;
                        root.set-file-logging(root.file-logging);
                        if (root.file-logging) { root.show-log-info = true; }
                    }
                }
                MenuItem {
                    text: "View log";
                    clicked => {
                        root.log-crash = root.read-crash-log();
                        root.log-file = root.read-file-log();
                        root.show-log-viewer = true;
                        root.menu-open = false;
                    }
                }
            }
        }
    }

    // Full-window scrollable log viewer. Kept last so it draws over every other
    // overlay (including the menu and the PDF viewer). Two Copy buttons — one
    // per section — because Slint's Android text-selection handles don't
    // extend inside a Flickable, so per-section clipboard export is the only
    // reliable way to pull just the interesting chunk into a bug report.
    if root.show-log-viewer : Rectangle {
        width: root.width;
        height: root.height;
        background: MaterialPalette.background;

        // Hidden TextInputs holding only one section each, driven by the
        // matching Copy button (select-all + copy). Not shown to the user;
        // exist purely to route each chunk to the platform clipboard without
        // disturbing the combined view above.
        crash-clip := TextInput {
            width: 0;
            height: 0;
            visible: false;
            text: root.log-crash;
            read-only: true;
            single-line: false;
        }
        file-clip := TextInput {
            width: 0;
            height: 0;
            visible: false;
            text: root.log-file;
            read-only: true;
            single-line: false;
        }

        VerticalLayout {
            padding-top: root.safe-area-insets.top;
            padding-bottom: root.safe-area-insets.bottom;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: "Log";
                    font-weight: 700;
                    font-size: 18px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.log-crash != "" : TonalButton {
                    text: "Copy crash";
                    clicked => {
                        crash-clip.select-all();
                        crash-clip.copy();
                    }
                }
                if root.log-file != "" : TonalButton {
                    text: "Copy file";
                    clicked => {
                        file-clip.select-all();
                        file-clip.copy();
                    }
                }
                TonalButton {
                    text: "Close";
                    clicked => { root.show-log-viewer = false; }
                }
            }
            // Flickable + read-only TextInput instead of TextEdit: TextEdit's
            // inner ScrollView doesn't expose `mouse-drag-pan-enabled`, so
            // touch dragging doesn't scroll on Android. Flickable is
            // interactive by default; TextInput still shows selection feedback
            // on long-press, though handle-drag extension is broken inside a
            // Flickable — hence the chunked Copy buttons above.
            Flickable {
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: log-view.preferred-height;
                log-view := TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    text: root.log-crash != ""
                        ? (root.log-file != "" ? root.log-crash + "\n\n" + root.log-file : root.log-crash)
                        : root.log-file;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    // Monospace: log lines align by columns; a proportional
                    // font makes timestamps and levels ragged.
                    font-family: "monospace";
                    font-size: 12px;
                    color: MaterialPalette.on-surface;
                    selection-background-color: MaterialPalette.primary;
                    selection-foreground-color: MaterialPalette.on-primary;
                }
            }
        }
    }
}
