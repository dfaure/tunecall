import { Button, LineEdit, ListView, TabWidget } from "std-widgets.slint";

struct SongResult {
    title: string,
    subtitle: string, // book title · page
}

struct BookEntry {
    name: string, // book stem (no extension)
    title: string, // human-readable title (empty if the index has none)
    installed: bool, // PDF present (searchable now) vs index-only
}

struct SetlistEntry {
    name: string,
    song-count: int,
}

struct SetlistSongEntry {
    title: string,
    subtitle: string, // book title · page (the stem if no friendly title)
    available: bool, // matching PDF installed (else greyed, opens to a render error)
}

// Hairline dividers. HSeparator is a horizontal line (full width, 1px tall) for
// separating stacked rows; VSeparator is a vertical line (1px wide, full height)
// for separating side-by-side columns. Each leaves the other dimension to fill,
// so don't swap them — a fixed size on the wrong axis breaks the parent layout.
component HSeparator inherits Rectangle {
    height: 1px;
    background: #0000001a;
}

component VSeparator inherits Rectangle {
    width: 1px;
    background: #0000001a;
}

// One row of a ListView: a hover highlight, the row content (laid out
// horizontally via @children), and a hairline bottom separator. Used by every
// list so rows read as discrete units instead of floating text.
component ListRow inherits Rectangle {
    height: content.preferred-height;
    background: hover.has-hover ? #00000008 : transparent;

    hover := TouchArea { }
    content := HorizontalLayout {
        padding: 8px;
        spacing: 6px;
        @children
    }
    HSeparator {
        y: parent.height - self.height;
        width: 100%;
    }
}

component ResultRow {
    in property <SongResult> data;
    callback clicked <=> touchArea.clicked;

    Rectangle {
        background: touchArea.has-hover ? #00000010 : transparent;
        touchArea := TouchArea {
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                Text {
                    text: data.title;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: data.subtitle;
                    color: gray;
                    font-size: 16px;
                    // Elide instead of demanding full width (a long book title
                    // must not push trailing buttons off-screen).
                    overflow: elide;
                }
            }
        }
        HSeparator {
            y: parent.height - self.height;
            width: 100%;
        }
    }
}

export component AppWindow inherits Window {
    title: "TuneCall";
    default-font-size: 20px;
    // No fixed preferred-width/height: on Android they made the window size to
    // the layout instead of filling the screen (search field hidden until a
    // resize/maximize forced a relayout). See slint-ui/slint#11170, #5391.

    // --- top-level tabs ---
    // 0 = Search, 1 = Setlists, 2 = Books. Rust sets it at startup (Books when
    // nothing is installed yet, to guide first-time setup; Search otherwise).
    in-out property <int> active-tab;

    // --- search ---
    in property <[SongResult]> results;
    in property <string> status;
    callback search(string);
    callback open-result(int); // index into `results`
    callback reload();

    // --- books list (setup-time: which PDFs are indexed/supported) ---
    in property <[BookEntry]> book-list;
    in property <string> about; // app name, version and build (footer of the Books tab)

    // --- setlists ---
    in property <[SetlistEntry]> setlists;
    in property <int> editing-index: -1; // -1 = list view, >=0 = editing that setlist
    in property <string> editing-name; // name of the setlist being edited
    in property <[SetlistSongEntry]> editing-songs;
    in property <[SongResult]> add-results; // search hits while adding songs
    callback create-setlist(string);
    callback rename-setlist(int/* index */, string/* new name */);
    callback delete-setlist(int);
    callback edit-setlist(int); // enter the editor
    callback close-setlist-editor();
    callback play-setlist(int); // open the setlist in the viewer
    callback setlist-add-search(string);
    callback setlist-add-song(int); // index into `add-results`
    callback preview-song(int); // preview `add-results[i]` in the viewer before adding
    callback setlist-remove-song(int); // index into `editing-songs`
    callback setlist-move-up(int);
    callback setlist-move-down(int);

    // --- viewer ---
    in property <bool> viewer-visible: false;
    in property <string> viewer-title;
    in property <image> page-image;
    in property <int> page-number;
    in property <int> page-count;
    in property <int> result-index; // 0-based position of the open song in the nav list
    in property <int> result-count; // total number of songs being navigated
    in property <string> viewer-error;
    // Zoom state (pinch / ctrl+wheel / double-tap). 1.0 = fit the page area;
    // the pan offsets are the zoomed page's position inside it (always <= 0).
    // Page flips keep the zoom (a margin crop survives across pages); Rust
    // resets all three when a different song is opened.
    in-out property <float> viewer-zoom: 1.0;
    in-out property <length> viewer-pan-x;
    in-out property <length> viewer-pan-y;
    callback render-zoomed(float); // re-rasterize the page to suit this zoom
    callback prev-page(); // within the open PDF
    callback next-page();
    callback prev-result(); // across the nav list (search results or a setlist)
    callback next-result();
    callback close-viewer();

    // On Android the search field keeps focus while the viewer covers it, so its
    // text caret/selection handles bleed through over the PDF. Drop focus while
    // the viewer is up and restore it (only on the Search tab) when we return.
    changed viewer-visible => {
        if (root.viewer-visible) {
            searchLineEdit.clear-focus();
        } else if (root.active-tab == 0) {
            searchLineEdit.focus();
        }
    }

    TabWidget {
        width: 100%;
        height: 100%;
        current-index <=> root.active-tab;

        Tab {
            title: "Search";

            VerticalLayout {
                padding: 8px;
                spacing: 8px;

                searchLineEdit := LineEdit {
                    placeholder-text: @tr("Search songs");
                    font-size: 28px;
                    edited(text) => { root.search(text); }
                }

                Text {
                    text: root.status;
                    color: gray;
                    wrap: word-wrap;
                }

                resultsList := ListView {
                    vertical-stretch: 1;
                    mouse-drag-pan-enabled: true;
                    horizontal-scrollbar-policy: always-off;
                    for result[idx] in root.results : ResultRow {
                        data: result;
                        width: resultsList.viewport-width;
                        clicked => { root.open-result(idx); }
                    }
                }
            }
        }

        Tab {
            title: "Setlists";

            Rectangle {
                // List view: every setlist, with create / play / edit / delete.
                if root.editing-index < 0 : VerticalLayout {
                    padding: 8px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        newName := LineEdit {
                            placeholder-text: "New setlist name";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Create";
                            enabled: newName.text != "";
                            clicked => {
                                root.create-setlist(newName.text);
                                newName.text = "";
                            }
                        }
                    }

                    setlistsList := ListView {
                        vertical-stretch: 1;
                        mouse-drag-pan-enabled: true;
                        horizontal-scrollbar-policy: always-off;
                        for s[idx] in root.setlists : ListRow {
                            width: setlistsList.viewport-width;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: s.name;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "\{s.song-count} song(s)";
                                    color: gray;
                                    font-size: 16px;
                                }
                            }
                            Button {
                                text: "Play";
                                enabled: s.song-count > 0;
                                clicked => { root.play-setlist(idx); }
                            }
                            Button {
                                text: "Edit";
                                clicked => { root.edit-setlist(idx); }
                            }
                            Button {
                                text: "Delete";
                                clicked => { root.delete-setlist(idx); }
                            }
                        }
                    }
                }

                // Editor view: rename/close on top, then two columns — the
                // setlist (reorder/remove) on the left, a live song search with
                // preview/add on the right (Mobile Sheets style).
                if root.editing-index >= 0 : VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;
                        // The name applies live as you type (no separate Rename
                        // button to forget). Rust skips empty input, so clearing
                        // the field to retype never wipes the stored name; it also
                        // doesn't write the name back here, so the caret is stable.
                        editName := LineEdit {
                            text: root.editing-name;
                            horizontal-stretch: 1;
                            edited(text) => { root.rename-setlist(root.editing-index, text); }
                        }
                        Button {
                            text: "Close";
                            clicked => { root.close-setlist-editor(); }
                        }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 12px;

                        // Left column: the setlist itself.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            Text {
                                text: "In this setlist";
                                font-weight: 700;
                            }
                            songsList := ListView {
                                vertical-stretch: 1;
                                mouse-drag-pan-enabled: true;
                                horizontal-scrollbar-policy: always-off;
                                for song[i] in root.editing-songs : ListRow {
                                    width: songsList.viewport-width;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text {
                                            text: "\{i + 1}. \{song.title}";
                                            font-weight: 700;
                                            color: song.available ? black : gray;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: song.available ? song.subtitle : "\{song.subtitle} — PDF missing";
                                            color: song.available ? gray : #b00020;
                                            font-size: 14px;
                                            overflow: elide;
                                        }
                                    }
                                    // Reorder/remove grouped tightly so they read
                                    // as one control cluster for this row.
                                    HorizontalLayout {
                                        spacing: 2px;
                                        Button {
                                            text: "▲";
                                            width: 44px;
                                            enabled: i > 0;
                                            clicked => { root.setlist-move-up(i); }
                                        }
                                        Button {
                                            text: "▼";
                                            width: 44px;
                                            enabled: i < root.editing-songs.length - 1;
                                            clicked => { root.setlist-move-down(i); }
                                        }
                                        Button {
                                            text: "✕";
                                            width: 44px;
                                            clicked => { root.setlist-remove-song(i); }
                                        }
                                    }
                                }
                            }
                        }

                        VSeparator { }

                        // Right column: live search to add songs. The field is
                        // always visible (no toggle); Preview opens the song in
                        // the viewer so the user isn't choosing blind.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            addSearch := LineEdit {
                                placeholder-text: @tr("Search songs to add");
                                edited(text) => { root.setlist-add-search(text); }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                addList := ListView {
                                    mouse-drag-pan-enabled: true;
                                    horizontal-scrollbar-policy: always-off;
                                    for r[ri] in root.add-results : ListRow {
                                        width: addList.viewport-width;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: r.title;
                                                font-weight: 700;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: r.subtitle;
                                                color: gray;
                                                font-size: 16px;
                                                overflow: elide;
                                            }
                                        }
                                        Button {
                                            text: "Preview";
                                            clicked => { root.preview-song(ri); }
                                        }
                                        Button {
                                            text: "Add";
                                            clicked => { root.setlist-add-song(ri); }
                                        }
                                    }
                                }
                                // Guidance while no search has been run yet.
                                if root.add-results.length == 0 : Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "Type above to find songs to add.";
                                    color: gray;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        Tab {
            title: "Books";

            // Setup-time: every indexed book, marking whether its PDF is
            // installed. PDFs are not bundled (copyright), so this tells the user
            // which PDFs they can install to enable a book.
            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Supported books";
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Reload";
                        clicked => { root.reload(); }
                    }
                }

                Text {
                    text: "Reload fetches the latest indexes. Install the matching PDF to enable a book; PDFs are not bundled.";
                    color: gray;
                    font-size: 16px;
                    wrap: word-wrap;
                }

                Text {
                    text: root.status;
                    color: gray;
                    font-size: 16px;
                    wrap: word-wrap;
                }

                booksList := ListView {
                    vertical-stretch: 1;
                    mouse-drag-pan-enabled: true;
                    horizontal-scrollbar-policy: always-off;
                    for book in root.book-list : ListRow {
                        width: booksList.viewport-width;
                        // Title (from the index) on top, file stem underneath in
                        // gray. When the index carries no title, the stem is the
                        // only name we have, so it stands in as the main line.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: book.title != "" ? book.title : book.name;
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                            if book.title != "" : Text {
                                text: book.name;
                                color: gray;
                                font-size: 16px;
                                wrap: word-wrap;
                            }
                        }
                        Text {
                            text: book.installed ? "installed" : "PDF missing";
                            color: book.installed ? #2e7d32 : gray;
                            vertical-alignment: center;
                        }
                    }
                }

                // App name / version / build, parked at the bottom so it's
                // available for bug reports without being intrusive.
                Text {
                    text: root.about;
                    color: gray;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Viewer overlay (covers the whole window, tab bar included, when a song is
    // open). A later sibling than the TabWidget, so it draws on top.
    if root.viewer-visible : Rectangle {
        width: root.width;
        height: root.height;
        background: white;

        VerticalLayout {
            padding: 8px;
            spacing: 6px;

            // Top bar navigates the nav list (the search hits for a song, or the
            // songs of a setlist), so you can step through without going back.
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "‹ Prev";
                    enabled: root.result-index > 0;
                    clicked => { root.prev-result(); }
                }
                Text {
                    text: "\{root.result-index + 1} / \{root.result-count}";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Next ›";
                    enabled: root.result-index < root.result-count - 1;
                    clicked => { root.next-result(); }
                }
                Button {
                    text: "Close";
                    clicked => { root.close-viewer(); }
                }
            }

            if !root.viewer-error.is-empty : Text {
                text: root.viewer-error;
                color: red;
                wrap: word-wrap;
            }

            // The page itself: tap the left/right half to flip pages within the
            // PDF, with a small page-number badge overlaid at the bottom.
            // Pinch (or ctrl+wheel, or double-tap) zooms; a single finger pans
            // while zoomed in.
            pageArea := Rectangle {
                vertical-stretch: 1;
                clip: true; // the zoomed page must not paint over the toolbar

                // Gesture-start state, so every update rescales from the start
                // values instead of accumulating per-frame rounding drift.
                property <float> start-zoom: 1.0;
                property <length> start-pan-x;
                property <length> start-pan-y;

                // The bottom badge covers the last line of music on some scans,
                // so it auto-hides a few seconds after the page changes and is
                // toggled back by a tap in the page's center. `badge-page` mirrors
                // page-number only so its `changed` handler fires on navigation
                // (open, page flip, or song change) — re-showing the badge and
                // restarting the fade each time.
                property <bool> badge-shown: true;
                property <int> badge-page: root.page-number;
                changed badge-page => {
                    self.badge-shown = true;
                    badgeHideTimer.restart();
                }
                badgeHideTimer := Timer {
                    interval: 5s;
                    running: true;
                    triggered => {
                        self.running = false;
                        pageArea.badge-shown = false;
                    }
                }

                // Zoom to `new-zoom` (clamped) keeping the page point under
                // (cx, cy) fixed on screen. old-* is the state the new zoom is
                // relative to (gesture start, or the current state for wheel).
                function zoom-to(new-zoom: float, cx: length, cy: length,
                                 old-zoom: float, old-pan-x: length, old-pan-y: length) {
                    root.viewer-zoom = clamp(new-zoom, 1.0, 4.0);
                    root.viewer-pan-x = cx - (cx - old-pan-x) * root.viewer-zoom / old-zoom;
                    root.viewer-pan-y = cy - (cy - old-pan-y) * root.viewer-zoom / old-zoom;
                    self.clamp-pan();
                    hiresTimer.restart();
                }
                // Keep the zoomed page covering the whole area (no gaps).
                function clamp-pan() {
                    root.viewer-pan-x = clamp(root.viewer-pan-x, self.width * (1 - root.viewer-zoom), 0px);
                    root.viewer-pan-y = clamp(root.viewer-pan-y, self.height * (1 - root.viewer-zoom), 0px);
                }

                // Re-rasterize sharper shortly after the zoom settles, not on
                // every pinch frame (rendering is synchronous).
                hiresTimer := Timer {
                    interval: 300ms;
                    running: false;
                    triggered => {
                        self.running = false;
                        root.render-zoomed(root.viewer-zoom);
                    }
                }

                gesture := ScaleRotateGestureHandler {
                    started => {
                        pageArea.start-zoom = root.viewer-zoom;
                        pageArea.start-pan-x = root.viewer-pan-x;
                        pageArea.start-pan-y = root.viewer-pan-y;
                    }
                    updated => {
                        pageArea.zoom-to(pageArea.start-zoom * self.scale,
                                         self.center.x, self.center.y,
                                         pageArea.start-zoom, pageArea.start-pan-x, pageArea.start-pan-y);
                    }

                    Image {
                        source: root.page-image;
                        image-fit: contain;
                        x: root.viewer-pan-x;
                        y: root.viewer-pan-y;
                        width: parent.width * root.viewer-zoom;
                        height: parent.height * root.viewer-zoom;
                    }

                    // One surface for all single-pointer interaction: drag to
                    // pan while zoomed in, tap the left/right 20% to flip pages
                    // (at any zoom — a margin crop must not block page turns),
                    // double-tap the middle to zoom in/out, ctrl+wheel to zoom
                    // on desktop. Tap vs drag is decided by movement distance.
                    panArea := TouchArea {
                        property <length> press-pan-x;
                        property <length> press-pan-y;
                        // The release of a pan drag also fires `clicked`; only
                        // treat it as a tap if the pointer barely moved.
                        pure function is-tap() -> bool {
                            Math.abs((self.mouse-x - self.pressed-x) / 1px) < 8
                                && Math.abs((self.mouse-y - self.pressed-y) / 1px) < 8
                        }
                        changed pressed => {
                            if (self.pressed) {
                                self.press-pan-x = root.viewer-pan-x;
                                self.press-pan-y = root.viewer-pan-y;
                            }
                        }
                        moved => {
                            if (root.viewer-zoom > 1.0) {
                                root.viewer-pan-x = self.press-pan-x + (self.mouse-x - self.pressed-x);
                                root.viewer-pan-y = self.press-pan-y + (self.mouse-y - self.pressed-y);
                                pageArea.clamp-pan();
                            }
                        }
                        clicked => {
                            if (self.is-tap()) {
                                if (self.pressed-x < self.width * 20% && root.page-number > 1) {
                                    root.prev-page();
                                } else if (self.pressed-x > self.width * 80% && root.page-number < root.page-count) {
                                    root.next-page();
                                } else if (self.pressed-x >= self.width * 20% && self.pressed-x <= self.width * 80%) {
                                    // Center tap: toggle the badge at once (the fade
                                    // is hide-only, so showing is instant) and stop
                                    // the auto-hide so the choice sticks.
                                    pageArea.badge-shown = !pageArea.badge-shown;
                                    badgeHideTimer.running = false;
                                }
                            }
                        }
                        double-clicked => {
                            // Middle 60% only: a double-tap on an edge zone is
                            // two page flips, not a zoom toggle.
                            if (self.pressed-x >= self.width * 20% && self.pressed-x <= self.width * 80%) {
                                if (root.viewer-zoom > 1.0) {
                                    pageArea.zoom-to(1.0, self.mouse-x, self.mouse-y,
                                                     root.viewer-zoom, root.viewer-pan-x, root.viewer-pan-y);
                                } else {
                                    pageArea.zoom-to(2.5, self.mouse-x, self.mouse-y, 1.0, 0px, 0px);
                                }
                            }
                        }
                        scroll-event(e) => {
                            if (e.modifiers.control) {
                                pageArea.zoom-to(root.viewer-zoom * (e.delta-y > 0 ? 1.1 : 1 / 1.1),
                                                 self.mouse-x, self.mouse-y,
                                                 root.viewer-zoom, root.viewer-pan-x, root.viewer-pan-y);
                                return accept;
                            }
                            reject
                        }
                    }
                }

                badge := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 8px;
                    width: badgeRow.preferred-width + 16px;
                    height: badgeRow.preferred-height + 6px;
                    background: #000000a0;
                    border-radius: 6px;
                    opacity: pageArea.badge-shown ? 1.0 : 0.0;
                    // Hide-only fade: showing is instant (0ms) so a tap feels
                    // responsive; the auto-hide and tap-dismiss fade out gently.
                    animate opacity { duration: pageArea.badge-shown ? 0ms : 300ms; }
                    // Book name (dimmed, so it stays unobtrusive) and page number
                    // share the badge, saving the vertical space a separate title
                    // line would take.
                    badgeRow := HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.viewer-title;
                            color: #ffffff99;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "· Page \{root.page-number} / \{root.page-count}";
                            color: white;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
