# Generated by Cargo
# will have compiled files and executables
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# gradle
.gradle
local.properties

# release signing secrets (see docs/RELEASE_SIGNING.md)
keystore.properties
*.keystore
*.jks

# build artefacts
*.so
# pdfium dylib fetched for iOS (fetch-pdfium.sh ios) — ships in the .app bundle
*.dylib
**/jniLibs
# scratch dir used by fetch-pdfium.sh (normally auto-removed)
/.pdfium-download*

# indexer crate build output
/indexer/target/

# iOS: only ios/project.yml + ios/build_for_ios_with_cargo.bash are source.
# The Xcode project, Info.plist and derived data are generated by xcodegen /
# xcodebuild (see the iOS build steps). libpdfium.dylib is covered by *.dylib.
/ios/build*/
/ios/*.log
/ios/*.xcodeproj/
/ios/Info.plist

# Scratch transcription images dropped in the repo root
/*.png
